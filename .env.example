# ==============================================================================
# AI QUIZ ASSISTANT 2.0 - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and fill in your credentials.
# ==============================================================================

# AI Provider Selection: 'gemini' (Google AI Studio) or 'custom' (OpenAI-compatible)
API_PROVIDER=gemini

# Google Gemini AI Studio Credentials
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Custom Local / Proxy API Configuration
# Compatible with Ollama, vLLM, LM Studio, or OpenAI-compatible endpoints
CUSTOM_API_URL=http://127.0.0.1:11434/v1
CUSTOM_API_KEY=your_custom_api_key_if_required
CUSTOM_MODEL=llama3.2-vision

# HUD Popup Placement: 'cursor' or 'fixed:x,y' (e.g., 'fixed:100,100')
POPUP_POSITION=cursor

# Logging Configuration: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
